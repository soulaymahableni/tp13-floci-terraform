# ALTERNATIVE : si Floci ne gère pas les écritures conditionnelles S3 (use_lockfile),
# on verrouille avec une table DynamoDB (clé LockID de type S).
#   aws dynamodb create-table --table-name tp13-tflock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST
# Puis : cp etapes/backend-dynamodb.tf.example backend.tf && terraform init -reconfigure
# (dynamodb_table est marqué "deprecated" depuis Terraform 1.11 mais fonctionne toujours.)

terraform {
  backend "s3" {
    bucket         = "tp13-tfstate"
    key            = "envs/dev/terraform.tfstate"
    region         = "us-east-1"
    profile        = "floci"
    encrypt        = true
    dynamodb_table = "tp13-tflock"

    endpoints = {
      s3       = "http://localhost:4566"
      dynamodb = "http://localhost:4566"
    }
    use_path_style              = true
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_requesting_account_id  = true
    skip_region_validation      = true
  }
}
