# DÉFI : Lambda créée par Terraform et déclenchée par la file SQS.
#   cp etapes/defi-lambda.tf.example defi-lambda.tf && terraform apply -var-file=dev.tfvars
# Test :
#   aws sqs send-message --queue-url "$(terraform output -raw queue_url)" --message-body '{"name":"Ada"}'
#   docker logs floci | grep -i hello

data "archive_file" "hello" {
  type        = "zip"
  source_file = "${path.module}/../lambda/index.mjs"
  output_path = "${path.module}/build/hello.zip"
}

resource "aws_iam_role" "lambda" {
  name = "tp13-lambda-${var.environment}"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_lambda_function" "hello" {
  function_name    = "tp13-hello-${var.environment}"
  role             = aws_iam_role.lambda.arn
  handler          = "index.handler"
  runtime          = "nodejs22.x"
  filename         = data.archive_file.hello.output_path
  source_code_hash = data.archive_file.hello.output_base64sha256
  timeout          = 10 # doit rester < visibility_timeout_seconds de la file (30 s)
}

resource "aws_lambda_event_source_mapping" "sqs" {
  event_source_arn = aws_sqs_queue.events.arn
  function_name    = aws_lambda_function.hello.arn
  batch_size       = 5
}

output "lambda_name" {
  value = aws_lambda_function.hello.function_name
}
